# ==============================================================================
# SPENDX Monorepo Environment Variables Example
# Copy to frontend/.env and backend/.env respectively
# ==============================================================================

# Backend (backend/.env)
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://spendx.vercel.app

# Supabase Auth & PostgreSQL Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Intelligence (Google Gemini or OpenRouter)
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Frontend (frontend/.env)
VITE_API_BASE_URL=https://api.spendx.railway.app/api/v1
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
